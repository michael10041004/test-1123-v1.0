# ==============================================================================
# Server-side Environment Variables (NEVER expose to client / browser bundles)
# Set these in Vercel Project Settings -> Environment Variables (or AI Studio Secrets)
# ==============================================================================

# Required: Google Gemini API Key used exclusively by /api/recommend-outfit
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Public deployment URL (auto-set in AI Studio; optional on Vercel)
APP_URL="MY_APP_URL"

# Optional: Comma-separated allowed CORS origins for /api/* (e.g. "https://example.vercel.app")
# Leave unset for default same-origin + Vercel preview + localhost handling
ALLOWED_ORIGIN=""

# Optional: Override upstream Open-Meteo endpoint if needed
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"

# ==============================================================================
# Client-side Environment Variables (Exposed to Vite via import.meta.env)
# ==============================================================================

# Optional: API base URL if frontend and API are hosted on different domains.
# Leave empty ("") for standard same-origin Vercel deployment (/api/*).
VITE_API_BASE_URL=""
